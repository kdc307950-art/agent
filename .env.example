DEEPSEEK_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
WEATHER_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search
WEATHER_FORECAST_URL=https://api.open-meteo.com/v1/forecast
TOOL_HTTP_TIMEOUT_SECONDS=5
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=langgraph-agent-dev
APP_ENV=development
TENANT_TOKEN_SECRET=
DEV_TENANT_TOKEN=
AUTH_MODE=dev
DEV_DEMO_LOGIN_ENABLED=false
DEV_DEMO_TOKEN_TTL_SECONDS=3600
OIDC_ISSUER_URL=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
OIDC_TENANT_CLAIM=tenant_id
OIDC_REQUIRED_SCOPES=chat:write
OIDC_CLOCK_SKEW_SECONDS=60
OIDC_JWKS_CACHE_SECONDS=300
OIDC_REQUIRE_JTI=true
OIDC_MAX_TOKEN_AGE_SECONDS=3600
OIDC_REVOCATION_MODE=none
# Web SSO（AUTH_MODE=oidc 时启用；四项必须同时配置，供 React PKCE 登录使用）
OIDC_CLIENT_ID=
OIDC_REDIRECT_URI=
OIDC_AUTHORIZATION_ENDPOINT=
OIDC_TOKEN_ENDPOINT=
OIDC_WEB_SCOPES=openid,profile,email
POSTGRES_USER=langgraph
POSTGRES_PASSWORD=
POSTGRES_DB=langgraph
DATABASE_URL=postgresql://langgraph:password@127.0.0.1:5432/langgraph
TEST_DATABASE_URL=postgresql://langgraph:password@127.0.0.1:5432/langgraph
REDIS_URL=redis://127.0.0.1:6379/0
RATE_LIMIT_BACKEND=redis
RATE_LIMIT_CAPACITY=60
RATE_LIMIT_REFILL_PER_SECOND=1
REDIS_SOCKET_TIMEOUT_SECONDS=1
REDIS_FAIL_MODE=closed
LANGGRAPH_AUTO_SETUP=false
# 图形态：single=单 Agent（默认）；workflow=按 JSON 编排图（含 supervisor 路由与人工审批）
AGENT_GRAPH_MODE=single
# workflow 模式必填；相对路径按项目根目录解析
AGENT_WORKFLOW_PATH=legacy-demo/workflows/legacy-demo.json
AGENT_RUN_TIMEOUT_SECONDS=60
MODEL_RETRY_ATTEMPTS=2
TOOL_RETRY_ATTEMPTS=1
TOOL_TENANT_ALLOWLIST=
AUDIT_WRITE_TIMEOUT_SECONDS=2
METRICS_ENABLED=true
METRICS_AUTH_TOKEN=
OTEL_SERVICE_NAME=langgraph-agent
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_METRIC_EXPORT_INTERVAL_MILLIS=15000
OTEL_TRACES_ENABLED=false
APP_VERSION=0.1.0
MODEL_INPUT_COST_PER_1K_USD=0
MODEL_OUTPUT_COST_PER_1K_USD=0
TENANT_DAILY_BUDGET_USD=0
CHECKPOINT_RETENTION_DAYS=30
AUDIT_RETENTION_ENABLED=false
AUDIT_RETENTION_DAYS=30
AUDIT_RETENTION_BATCH_SIZE=1000
AUDIT_RETENTION_MAX_RUNTIME_SECONDS=60
SQLITE_CHECKPOINT_PATH=checkpoints.db
MIGRATION_TENANT_ID=local
MIGRATION_USER_ID=developer
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://localhost:3000
RATE_LIMIT_PER_MINUTE=60
GRAFANA_ADMIN_PASSWORD=
PG_DUMP_BIN=pg_dump
PG_RESTORE_BIN=pg_restore
WEBHOOK_REPLAY_WINDOW_SECONDS=300
# 企业微信 Webhook：四项必须同时配置；未配置时端点返回 503
WECOM_TENANT_ID=
WECOM_TOKEN=
WECOM_ENCODING_AES_KEY=
WECOM_CORP_ID=
# 钉钉 Webhook：两项必须同时配置；未配置时端点返回 503
DINGTALK_TENANT_ID=
DINGTALK_APP_SECRET=

# 知识向量检索（可选）：配置端点后启用 hybrid 检索与评测（backend/run_knowledge_eval.py --embed）
KNOWLEDGE_EMBEDDING_MODEL=
KNOWLEDGE_EMBEDDING_DIMENSION=1536
KNOWLEDGE_EMBEDDING_ENDPOINT=
# 若 endpoint 是仓库内 embedding proxy，填写其 EMBEDDING_PROXY_TOKEN；不要复用上游 API key
KNOWLEDGE_EMBEDDING_TOKEN=

# === VPN Diagnosis / Command（backend/vpn）===
# 数据源模式：mock(固定Mock) / sandbox(可重复沙箱) / real(真实只读 HTTP)；默认 mock
VPN_ADAPTER_MODE=mock
# real 模式必填（backend/vpn/http_adapter.py build_http_config_from_env 强校验）
VPN_HTTP_BASE_URL=
VPN_API_KEY=
VPN_TENANT_ID=
VPN_HTTP_CONNECT_TIMEOUT=3
VPN_HTTP_READ_TIMEOUT=5
VPN_HTTP_MAX_RETRIES=3
# 只读 HTTP 的自定义 header 名（对接方要求改名时再改，一般保持默认）
VPN_HTTP_AUTH_HEADER=Authorization
VPN_HTTP_TENANT_HEADER=X-Tenant-Id
VPN_HTTP_REQUEST_ID_HEADER=X-Request-Id
# 沙箱数据文件（可选）：VPN_ADAPTER_MODE=sandbox 的可重复种子与 mock 数据文件路径
VPN_SANDBOX_SEED=0
VPN_MOCK_DATA_PATH=
# 控制面写入网关：disabled=默认关闭；fortimanager=启用真实 FMG install task
# （启用时 backend/settings.py 强制要求 VPN_FMG_BASE_URL / VPN_FMG_API_TOKEN /
#   VPN_FMG_TENANT_TARGETS_JSON 三键；FMG ≥7.2.2 才支持 Bearer token）
VPN_COMMAND_GATEWAY_MODE=disabled
VPN_FMG_BASE_URL=
VPN_FMG_API_TOKEN=
# 可选：多 API 用户共存时声明 access_user header（FMG 7.6.7/8.0.0+）
VPN_FMG_ACCESS_USER=
# 租户显式目标映射 JSON：{"tenant_id": {"adom": "...", "device": "...", "vdom": "root",
#   "package": "...", "install_kind": "package|device"}}；package 下发必须带 package
VPN_FMG_TENANT_TARGETS_JSON=
VPN_FMG_VERIFY_TLS=true
VPN_FMG_CONNECT_TIMEOUT=3
VPN_FMG_READ_TIMEOUT=10
VPN_FMG_POLL_INTERVAL_SECONDS=2
VPN_FMG_MAX_WAIT_SECONDS=600
